<mxfile host="gcp-architecture-diagram-skill">
  <diagram name="Web app on Cloud Run">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Online shop: orders service&lt;/b&gt;&lt;br&gt;Example | 2026-10-16 | v1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;spacing=8;fontFamily=Google Sans,Roboto,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="460" height="60" as="geometry"/>
        </mxCell>

        <!-- actor, outside Google Cloud; main lane center y = 440 -->
        <mxCell id="user" value="Customer" style="gcpShape=user;" vertex="1" parent="1">
          <mxGeometry x="60" y="416" width="48" height="48" as="geometry"/>
        </mxCell>

        <!-- boundaries: google_cloud (160,100) > project (180,140) -->
        <mxCell id="gc" value="Google Cloud" style="gcpGroup=google_cloud;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="820" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="prj" value="Project: shop-prod" style="gcpGroup=project;" vertex="1" parent="gc">
          <mxGeometry x="20" y="40" width="780" height="790" as="geometry"/>
        </mxCell>

        <!-- edge + serverless, outside the VPC (coordinates relative to prj) -->
        <mxCell id="lb" value="Cloud Load Balancing&lt;br&gt;+ Cloud Armor" style="gcpIcon=cloud_load_balancing;" vertex="1" parent="prj">
          <mxGeometry x="40" y="268" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="run" value="Cloud Run&lt;br&gt;orders-api" style="gcpIcon=cloud_run;labelPosition=right;verticalLabelPosition=top;align=left;verticalAlign=bottom;" vertex="1" parent="prj">
          <mxGeometry x="240" y="268" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- event lane, center y = 240 absolute -->
        <mxCell id="ps" value="Pub/Sub&lt;br&gt;order-events" style="gcpIcon=pubsub;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="prj">
          <mxGeometry x="240" y="68" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="fn" value="Cloud Run functions&lt;br&gt;to-analytics" style="gcpIcon=cloud_functions;" vertex="1" parent="prj">
          <mxGeometry x="440" y="68" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="bq" value="BigQuery&lt;br&gt;sales" style="gcpIcon=bigquery;" vertex="1" parent="prj">
          <mxGeometry x="640" y="68" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- VPC (global) > subnet (regional), private-IP data services -->
        <mxCell id="vpc" value="VPC: shop-vpc" style="gcpGroup=vpc;" vertex="1" parent="prj">
          <mxGeometry x="400" y="180" width="240" height="414" as="geometry"/>
        </mxCell>
        <mxCell id="subnet" value="europe-west1 · 10.10.0.0/24" style="gcpGroup=subnet;fontStyle=0;fontSize=12;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="40" width="200" height="354" as="geometry"/>
        </mxCell>
        <mxCell id="sql" value="Cloud SQL&lt;br&gt;orders-db" style="gcpIcon=cloud_sql;" vertex="1" parent="subnet">
          <mxGeometry x="60" y="48" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Memorystore&lt;br&gt;sessions" style="gcpIcon=memorystore;" vertex="1" parent="subnet">
          <mxGeometry x="60" y="228" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- ops lane -->
        <mxCell id="ops" value="Operations" style="gcpGroup=logical;" vertex="1" parent="prj">
          <mxGeometry x="200" y="600" width="544" height="164" as="geometry"/>
        </mxCell>
        <mxCell id="log" value="Cloud Logging" style="gcpIcon=cloud_logging;" vertex="1" parent="ops">
          <mxGeometry x="40" y="48" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="mon" value="Cloud Monitoring" style="gcpIcon=cloud_monitoring;" vertex="1" parent="ops">
          <mxGeometry x="240" y="48" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="sm" value="Secret Manager" style="gcpIcon=secret_manager;" vertex="1" parent="ops">
          <mxGeometry x="440" y="48" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- edges: all parent="1" -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="lb">
          <mxGeometry x="-0.6" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lb" target="run">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="private IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="sql">
          <mxGeometry x="-0.6" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ps" target="fn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="insert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5F6368;endArrow=block;endFill=1;fontSize=11;fontColor=#3C4043;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="bq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
